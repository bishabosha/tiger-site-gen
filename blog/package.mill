package build.blog

import mill.*
import mill.scalalib.*

object `package` extends build.TigerModule:
  def moduleDeps = Seq(breezeSite, home, build.live)
  def mainClass = Some("blog.makeSite")

  object breezeSite extends build.TigerModule:
    def moduleDeps = Seq(build.breeze)

  object home extends build.TigerModule:
    def moduleDeps = Seq(build.core)

  object test extends ScalaTests, TestModule.Munit:
    def moduleDeps = super.moduleDeps ++ Seq(build.live.test)
    def munitVersion = "1.3.3"
